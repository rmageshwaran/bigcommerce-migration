# ===== DOCKER BUILD OPTIMIZATION =====
# This is the PRIMARY .dockerignore - individual project .dockerignore files don't apply

# ===== BUILD ARTIFACTS (CRITICAL FOR PERFORMANCE) =====
**/obj/
**/bin/
**/TestResults/
**/build/
**/dist/
**/out/
**/.cache/
**/.nuget/
**/packages/
**/node_modules/

# ===== SPECIFIC LARGE DIRECTORIES =====
src/BigCommerce.Migration.Dashboard/node_modules/
src/BigCommerce.Migration.Dashboard/dist/
tests/
**/tests/

# ===== DEVELOPMENT FILES =====
**/.vs/
**/.vscode/
**/.idea/
*.user
*.suo
*.tmp
*.log
**/.DS_Store
**/Thumbs.db

# ===== GIT AND DOCUMENTATION =====
.git/
.gitignore
**/*.md
**/README*
docs/

# ===== INFRASTRUCTURE AND SCRIPTS =====
iac/
scripts/
etl-benchmarks/
azure-pipelines*.yml

# ===== FUNCTION-SPECIFIC EXCLUSIONS =====
**/local.settings.json
**/.azure/
**/.azurite/
**/Properties/PublishProfiles/

# ===== REACT/NODE SPECIFIC =====
**/coverage/
**/.nyc_output/
**/.parcel-cache/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# ===== KEEP ESSENTIAL FILES =====
!src/
!src/**/*.cs
!src/**/*.csproj
!src/**/*.json
!src/**/*.tsx
!src/**/*.ts
!src/**/*.js
!src/**/*.html
!src/**/*.css 