# Clean Dockerfile for BigCommerce Migration Functions
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build

WORKDIR /src

# Set environment variables for clean build
ENV DOTNET_SKIP_FIRST_TIME_EXPERIENCE=true
ENV DOTNET_NOLOGO=true
ENV DOTNET_CLI_TELEMETRY_OPTOUT=true
ENV NUGET_PACKAGES=/tmp/.nuget/packages

# Create clean NuGet config to avoid Windows path issues
RUN mkdir -p /tmp/.nuget/packages && \
    echo '<?xml version="1.0" encoding="utf-8"?>' > nuget.config && \
    echo '<configuration>' >> nuget.config && \
    echo '  <packageSources>' >> nuget.config && \
    echo '    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />' >> nuget.config && \
    echo '  </packageSources>' >> nuget.config && \
    echo '  <fallbackPackageFolders>' >> nuget.config && \
    echo '    <clear />' >> nuget.config && \
    echo '  </fallbackPackageFolders>' >> nuget.config && \
    echo '  <config>' >> nuget.config && \
    echo '    <add key="globalPackagesFolder" value="/tmp/.nuget/packages" />' >> nuget.config && \
    echo '  </config>' >> nuget.config && \
    echo '</configuration>' >> nuget.config

# Copy project files (including CodeAnalysis project)
COPY src/BigCommerce.Migration.Core/BigCommerce.Migration.Core.csproj src/BigCommerce.Migration.Core/
COPY src/BigCommerce.Migration.Infrastructure/BigCommerce.Migration.Infrastructure.csproj src/BigCommerce.Migration.Infrastructure/
COPY src/BigCommerce.Migration.Activities/BigCommerce.Migration.Activities.csproj src/BigCommerce.Migration.Activities/
COPY src/BigCommerce.Migration.CodeAnalysis/BigCommerce.Migration.CodeAnalysis.csproj src/BigCommerce.Migration.CodeAnalysis/
COPY src/BigCommerce.Migration.Functions/BigCommerce.Migration.Functions.csproj src/BigCommerce.Migration.Functions/

# Restore packages
RUN dotnet restore src/BigCommerce.Migration.Functions/BigCommerce.Migration.Functions.csproj \
    --configfile nuget.config \
    --packages /tmp/.nuget/packages \
    --verbosity minimal

# Copy source code (dockerignore handles excluding obj/bin)
COPY src/ src/

# Build and publish
RUN dotnet publish src/BigCommerce.Migration.Functions/BigCommerce.Migration.Functions.csproj \
    -c Release \
    -o /app/publish \
    --configfile nuget.config \
    --no-restore \
    --verbosity minimal \
    /p:UseAppHost=false

# Runtime stage
FROM mcr.microsoft.com/azure-functions/dotnet-isolated:4-dotnet-isolated8.0

# Install curl for health checks
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /home/site/wwwroot

# Copy published application
COPY --from=build /app/publish .

# Copy local settings for Docker if it exists, otherwise create default
COPY --from=build /src/src/BigCommerce.Migration.Functions/local.settings.docker.json ./local.settings.json

# Expose port
EXPOSE 80

# Set environment variables
ENV AzureWebJobsScriptRoot=/home/site/wwwroot \
    AzureFunctionsJobHost__Logging__Console__IsEnabled=true \
    AzureWebJobsFeatureFlags=EnableWorkerIndexing

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost/api/health || exit 1 