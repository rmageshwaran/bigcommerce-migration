# Fixed Dockerfile for BigCommerce Migration Functions
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build

WORKDIR /src

# Set environment variables for stable builds
ENV DOTNET_SKIP_FIRST_TIME_EXPERIENCE=true
ENV DOTNET_CLI_TELEMETRY_OPTOUT=true
ENV NUGET_XMLDOC_MODE=skip

# Copy the entire solution file first
COPY BigCommerce.Migration.sln .

# Copy all project files first (including analyzers)
COPY src/BigCommerce.Migration.Core/BigCommerce.Migration.Core.csproj src/BigCommerce.Migration.Core/
COPY src/BigCommerce.Migration.Infrastructure/BigCommerce.Migration.Infrastructure.csproj src/BigCommerce.Migration.Infrastructure/
COPY src/BigCommerce.Migration.Activities/BigCommerce.Migration.Activities.csproj src/BigCommerce.Migration.Activities/
COPY src/BigCommerce.Migration.Functions/BigCommerce.Migration.Functions.csproj src/BigCommerce.Migration.Functions/
COPY src/BigCommerce.Migration.CodeAnalysis/BigCommerce.Migration.CodeAnalysis.csproj src/BigCommerce.Migration.CodeAnalysis/

# Restore the entire solution to ensure all dependencies are available
RUN dotnet restore BigCommerce.Migration.sln \
    --verbosity normal \
    --force \
    --no-cache

# Copy all source code
COPY src/ src/

# Build the entire solution first to ensure analyzers work
RUN dotnet build BigCommerce.Migration.sln \
    -c Release \
    --no-restore

# Publish only the Functions project
RUN dotnet publish src/BigCommerce.Migration.Functions/BigCommerce.Migration.Functions.csproj \
    -c Release \
    -o /app/publish \
    --no-build \
    /p:UseAppHost=false

# Runtime stage
FROM mcr.microsoft.com/azure-functions/dotnet-isolated:4-dotnet-isolated8.0

# Install curl for health checks  
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /home/site/wwwroot

# Copy published app
COPY --from=build /app/publish .

# Copy local.settings.json for Docker configuration
COPY src/BigCommerce.Migration.Functions/local.settings.docker.json ./local.settings.json

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:80/api/health || exit 1 