# No-Analyzers Dockerfile for BigCommerce Migration Functions
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build

WORKDIR /src

# Disable analyzers completely
ENV DOTNET_SKIP_FIRST_TIME_EXPERIENCE=true
ENV DOTNET_CLI_TELEMETRY_OPTOUT=true
ENV NUGET_XMLDOC_MODE=skip

# Copy project files
COPY src/BigCommerce.Migration.Core/BigCommerce.Migration.Core.csproj src/BigCommerce.Migration.Core/
COPY src/BigCommerce.Migration.Infrastructure/BigCommerce.Migration.Infrastructure.csproj src/BigCommerce.Migration.Infrastructure/
COPY src/BigCommerce.Migration.Orchestration/BigCommerce.Migration.Orchestration.csproj src/BigCommerce.Migration.Orchestration/
COPY src/BigCommerce.Migration.Functions/BigCommerce.Migration.Functions.csproj src/BigCommerce.Migration.Functions/

# Copy source code
COPY src/BigCommerce.Migration.Core/ src/BigCommerce.Migration.Core/
COPY src/BigCommerce.Migration.Infrastructure/ src/BigCommerce.Migration.Infrastructure/
COPY src/BigCommerce.Migration.Orchestration/ src/BigCommerce.Migration.Orchestration/
COPY src/BigCommerce.Migration.Functions/ src/BigCommerce.Migration.Functions/

# Build with analyzers completely disabled
RUN dotnet publish src/BigCommerce.Migration.Functions/BigCommerce.Migration.Functions.csproj \
    -c Release \
    -o /app/publish \
    /p:UseAppHost=false \
    /p:RunAnalyzersDuringBuild=false \
    /p:RunCodeAnalysis=false \
    /p:TreatWarningsAsErrors=false \
    /p:WarningsAsErrors= \
    --verbosity minimal

# Runtime stage  
FROM --platform=linux/amd64 mcr.microsoft.com/azure-functions/dotnet-isolated:4-dotnet-isolated8.0

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

WORKDIR /home/site/wwwroot

COPY --from=build /app/publish .
COPY src/BigCommerce.Migration.Functions/local.settings.docker.json ./local.settings.json

EXPOSE 80 