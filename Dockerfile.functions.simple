# Simplified Dockerfile for BigCommerce Migration Functions (No Analyzers)
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build

WORKDIR /src

# Set environment variables
ENV DOTNET_SKIP_FIRST_TIME_EXPERIENCE=true
ENV DOTNET_CLI_TELEMETRY_OPTOUT=true

# Copy core project files only (exclude CodeAnalysis)
COPY src/BigCommerce.Migration.Core/BigCommerce.Migration.Core.csproj src/BigCommerce.Migration.Core/
COPY src/BigCommerce.Migration.Infrastructure/BigCommerce.Migration.Infrastructure.csproj src/BigCommerce.Migration.Infrastructure/
COPY src/BigCommerce.Migration.Orchestration/BigCommerce.Migration.Orchestration.csproj src/BigCommerce.Migration.Orchestration/

# Create a temporary Functions project without analyzer reference
COPY src/BigCommerce.Migration.Functions/BigCommerce.Migration.Functions.csproj src/BigCommerce.Migration.Functions/BigCommerce.Migration.Functions.csproj.original

# Remove analyzer reference from Functions project for Docker build
RUN sed '/<ProjectReference.*BigCommerce.Migration.CodeAnalysis.*\/>/d' \
    src/BigCommerce.Migration.Functions/BigCommerce.Migration.Functions.csproj.original \
    > src/BigCommerce.Migration.Functions/BigCommerce.Migration.Functions.csproj

# Restore packages
RUN dotnet restore src/BigCommerce.Migration.Functions/BigCommerce.Migration.Functions.csproj

# Copy source code (exclude CodeAnalysis)
COPY src/BigCommerce.Migration.Core/ src/BigCommerce.Migration.Core/
COPY src/BigCommerce.Migration.Infrastructure/ src/BigCommerce.Migration.Infrastructure/
COPY src/BigCommerce.Migration.Orchestration/ src/BigCommerce.Migration.Orchestration/
COPY src/BigCommerce.Migration.Functions/ src/BigCommerce.Migration.Functions/

# Build and publish
RUN dotnet publish src/BigCommerce.Migration.Functions/BigCommerce.Migration.Functions.csproj \
    -c Release \
    -o /app/publish \
    --no-restore \
    /p:UseAppHost=false

# Runtime stage
FROM mcr.microsoft.com/azure-functions/dotnet-isolated:4-dotnet-isolated8.0

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

WORKDIR /home/site/wwwroot

COPY --from=build /app/publish .
COPY src/BigCommerce.Migration.Functions/local.settings.docker.json ./local.settings.json

EXPOSE 80 