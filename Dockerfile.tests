# Multi-stage Dockerfile for BigCommerce Migration Tests
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS test-base
WORKDIR /app

# Copy solution file and project files
COPY BigCommerce.Migration.sln ./
COPY src/BigCommerce.Migration.Core/*.csproj ./src/BigCommerce.Migration.Core/
COPY src/BigCommerce.Migration.Infrastructure/*.csproj ./src/BigCommerce.Migration.Infrastructure/
COPY src/BigCommerce.Migration.Functions/*.csproj ./src/BigCommerce.Migration.Functions/
COPY src/BigCommerce.Migration.Orchestration/*.csproj ./src/BigCommerce.Migration.Orchestration/
COPY src/BigCommerce.Migration.CodeAnalysis/*.csproj ./src/BigCommerce.Migration.CodeAnalysis/
COPY tests/BigCommerce.Migration.UnitTests/*.csproj ./tests/BigCommerce.Migration.UnitTests/
COPY tests/BigCommerce.Migration.OrchestrationTests/*.csproj ./tests/BigCommerce.Migration.OrchestrationTests/
COPY tests/BigCommerce.Migration.IntegrationTests/*.csproj ./tests/BigCommerce.Migration.IntegrationTests/
COPY tests/BigCommerce.Migration.PerformanceTests/*.csproj ./tests/BigCommerce.Migration.PerformanceTests/

# Restore packages
RUN dotnet restore

# Copy source code
COPY src/ ./src/
COPY tests/ ./tests/

# Build all projects
RUN dotnet build --no-restore -c Release

# Unit Tests Stage
FROM test-base AS unit-tests
WORKDIR /app
ENTRYPOINT ["dotnet", "test", "tests/BigCommerce.Migration.UnitTests/BigCommerce.Migration.UnitTests.csproj", "--no-build", "-c", "Release", "--logger", "trx", "--results-directory", "/testresults", "--logger", "console;verbosity=detailed"]

# Orchestration Tests Stage  
FROM test-base AS orchestration-tests
WORKDIR /app
ENTRYPOINT ["dotnet", "test", "tests/BigCommerce.Migration.OrchestrationTests/BigCommerce.Migration.OrchestrationTests.csproj", "--no-build", "-c", "Release", "--logger", "trx", "--results-directory", "/testresults", "--logger", "console;verbosity=detailed"]

# Integration Tests Stage
FROM test-base AS integration-tests
WORKDIR /app
ENTRYPOINT ["dotnet", "test", "tests/BigCommerce.Migration.IntegrationTests/BigCommerce.Migration.IntegrationTests.csproj", "--no-build", "-c", "Release", "--logger", "trx", "--results-directory", "/testresults", "--logger", "console;verbosity=detailed"]

# Performance Tests Stage
FROM test-base AS performance-tests
WORKDIR /app
ENTRYPOINT ["dotnet", "test", "tests/BigCommerce.Migration.PerformanceTests/BigCommerce.Migration.PerformanceTests.csproj", "--no-build", "-c", "Release", "--logger", "trx", "--results-directory", "/testresults", "--logger", "console;verbosity=detailed"]

# All Tests Stage (run all test suites)
FROM test-base AS all-tests
WORKDIR /app
ENTRYPOINT ["dotnet", "test", "--no-build", "-c", "Release", "--logger", "trx", "--results-directory", "/testresults", "--logger", "console;verbosity=detailed"] 