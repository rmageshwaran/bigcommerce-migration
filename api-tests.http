###
POST {{baseUrl}}/api/migrations
Content-Type: {{contentType}}

{
  "entities": ["categories"],
  "destinationStore": {
    "storeId": "{{testDestStoreId}}",
    "accessToken": "{{testDestAccessToken}}",
    "channelId": "{{testChannelId}}"
  }
}

