# BigCommerce Migration System - Environment Variables Example
# Copy this file to .env and configure with your actual values

# =================================================================
# AZURE STORAGE CONFIGURATION
# =================================================================
# For local development, use Azurite (automatically configured)
# For production, use real Azure Storage account
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net

# =================================================================
# OPENSEARCH CONFIGURATION
# =================================================================
OPENSEARCH_ENDPOINT=https://your-opensearch-endpoint.com
OPENSEARCH_USERNAME=your_username
OPENSEARCH_PASSWORD=your_secure_password

# =================================================================
# AZURE SIGNALR CONFIGURATION
# =================================================================
AZURE_SIGNALR_CONNECTION_STRING=Endpoint=https://your-signalr.service.signalr.net;AccessKey=your_access_key;Version=1.0;

# =================================================================
# APPLICATION INSIGHTS (MONITORING)
# =================================================================
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=your_key;IngestionEndpoint=https://your_region.applicationinsights.azure.com/

# =================================================================
# BIGCOMMERCE API CONFIGURATION
# =================================================================
# These are typically configured per migration request, but can be set as defaults
BIGCOMMERCE_DEFAULT_STORE_HASH=your_store_hash
BIGCOMMERCE_DEFAULT_ACCESS_TOKEN=your_access_token

# =================================================================
# DASHBOARD CONFIGURATION
# =================================================================
REACT_APP_API_BASE_URL=https://api.migration.company.com/api/dashboard
REACT_APP_SIGNALR_URL=https://api.migration.company.com/api
REACT_APP_ENVIRONMENT=production

# =================================================================
# MONITORING AND SECURITY
# =================================================================
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password

# =================================================================
# PERFORMANCE OPTIMIZATION SETTINGS
# =================================================================
# These leverage our completed performance optimization work
APP_SETTINGS_BATCH_SIZE=20
APP_SETTINGS_MAX_CONCURRENCY=8
APP_SETTINGS_RETRY_ATTEMPTS=3

# BigCommerce API Rate Limiting (optimized settings)
BIGCOMMERCE_RATE_LIMIT_REQUESTS_PER_SECOND=12
BIGCOMMERCE_REQUEST_TIMEOUT=00:00:30
BIGCOMMERCE_MAX_RETRIES=3

# =================================================================
# ENVIRONMENT-SPECIFIC OVERRIDES
# =================================================================

# Development Environment
# ASPNETCORE_ENVIRONMENT=Development
# LOGGING_LOGLEVEL_DEFAULT=Debug
# APP_SETTINGS_BATCH_SIZE=5
# APP_SETTINGS_MAX_CONCURRENCY=2

# Staging Environment
# ASPNETCORE_ENVIRONMENT=Staging
# OPENSEARCH_DEFAULT_INDEX=migration-staging
# APP_SETTINGS_BATCH_SIZE=15
# APP_SETTINGS_MAX_CONCURRENCY=6

# Production Environment
# ASPNETCORE_ENVIRONMENT=Production
# OPENSEARCH_DEFAULT_INDEX=migration-production
# LOGGING_LOGLEVEL_DEFAULT=Warning
# LOGGING_LOGLEVEL_BIGCOMMERCE_MIGRATION=Information 