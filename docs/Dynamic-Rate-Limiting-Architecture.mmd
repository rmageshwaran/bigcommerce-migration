graph TD
    subgraph "Request Flow"
        REQ[API Request] --> AH[ApiRequestHandler]
        AH --> DRL[DynamicRateLimiter]
        DRL --> CMP[CanMakeRequest?]
        CMP -->|No| WAIT[CheckAndWaitAsync]
        CMP -->|Yes| EXEC[Execute Request]
        WAIT --> EXEC
        EXEC --> REC[RecordApiCall]
    end

    subgraph "Multi-Layer Rate Limiting"
        DRL --> L1[Layer 1: Basic Rate Limiter]
        DRL --> L2[Layer 2: Dynamic Rate Limiter]
        DRL --> L3[Layer 3: Enhanced Dynamic Limiter]
        DRL --> L4[Layer 4: Predictive Limiter]
    end

    subgraph "Real-Time Intelligence"
        BC[BigCommerce API] --> HEADERS[Response Headers]
        HEADERS --> XRL1[X-Rate-Limit-Requests-Left]
        HEADERS --> XRL2[X-Rate-Limit-Requests-Quota]
        HEADERS --> XRL3[X-Rate-Limit-Time-Reset-Ms]
        XRL1 --> QT[DistributedQuotaTracker]
        XRL2 --> QT
        XRL3 --> QT
    end

    subgraph "Health Monitoring"
        AHM[ApiHealthMonitor] --> RT[Response Time]
        AHM --> ER[Error Rate]
        AHM --> BC_DATA[BigCommerce Limits]
        RT --> CALC[RateCalculator]
        ER --> CALC
        BC_DATA --> CALC
        CALC --> OR[Optimal Rate: 5-50 req/sec]
    end

    subgraph "Multi-Instance Coordination"
        I1[Instance A] --> ATS[Azure Table Storage]
        I2[Instance B] --> ATS
        I3[Instance C] --> ATS
        ATS --> ICM[InstanceCoordinationManager]
        ATS --> TCM[TokenConsensusManager]
        ICM --> HEART[Heartbeat Management]
        TCM --> TOKEN[Token Distribution]
    end

    subgraph "Adaptive Concurrency"
        ACC[AdaptiveConcurrencyController] --> SYS[System Metrics]
        SYS --> CPU[CPU Usage]
        SYS --> MEM[Memory Pressure]
        SYS --> LAT[Latency Tracking]
        ACC --> CONC[Optimal Concurrency: 2-50]
    end

    subgraph "Safety Mechanisms"
        CB[Circuit Breaker] --> OPEN[Open State]
        CB --> HALF[Half-Open State] 
        CB --> CLOSED[Closed State]
        FALLBACK[Fallback Rate: 8 req/sec] --> SAFETY[Safety Buffer: 15-50%]
    end

    REC --> AHM
    QT --> ATS
    OR --> DRL
    CONC --> DRL
    CB --> DRL

    style REQ fill:#e1f5fe
    style OR fill:#c8e6c9
    style CONC fill:#c8e6c9
    style ATS fill:#fff3e0
    style FALLBACK fill:#ffcdd2