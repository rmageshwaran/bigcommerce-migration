# React Dashboard Project - .dockerignore
# Exclude node dependencies (will be installed in container)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Exclude build outputs
build/
dist/
.next/
out/

# Exclude development cache
.cache/
.parcel-cache/
.nyc_output/
coverage/

# Exclude development tools
.vscode/
.idea/
.vs/

# Exclude OS files
.DS_Store
Thumbs.db
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# Exclude Git
.git/
.gitignore

# Exclude environment files (use docker-compose for env)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Exclude documentation
*.md
README*
docs/

# Exclude testing
__tests__/
*.test.js
*.test.ts
*.test.tsx
*.spec.js
*.spec.ts
*.spec.tsx

# Exclude other projects
../../tests/
../../src/BigCommerce.Migration.Functions/
../../src/BigCommerce.Migration.Core/
../../src/BigCommerce.Migration.Infrastructure/
../../src/BigCommerce.Migration.Orchestration/
../../src/BigCommerce.Migration.CodeAnalysis/

# Keep essential React files
!src/
!public/
!package*.json
!tsconfig.json
!Dockerfile* 