# BigCommerce Migration Dashboard - Development Configuration
VITE_API_BASE_URL=http://localhost:7071
VITE_SIGNALR_HUB_URL=https://vortexiq-migration-signalr-dev.service.signalr.net
VITE_API_KEY=your-azure-functions-api-key-here

# Feature Flags
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_REALTIME=true
VITE_ENABLE_DEBUG_LOGGING=true

# Performance Configuration
VITE_POLLING_INTERVAL=5000
VITE_RECONNECT_ATTEMPTS=5
VITE_CONNECTION_TIMEOUT=30000

# Dashboard Configuration
VITE_DEFAULT_REFRESH_INTERVAL=10000
VITE_MAX_EVENT_HISTORY=100
VITE_PERFORMANCE_BASELINE=100
