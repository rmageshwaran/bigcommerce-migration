{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
    "MigrationStartQueueName": "migration-start",
    "EntityBatchQueueName": "entity-batch",
    "BatchCompletionQueueName": "batch-completion",
    "CancellationQueueName": "cancellation",
    "ProgressUpdateQueueName": "progress-update",
    "DeadLetterQueueName": "dead-letter",
    "RetryQueueName": "retry"
  },
  "ConnectionStrings": {
    "AzureSignalR": "Endpoint=https://your-signalr-service.service.signalr.net;AccessKey=your-access-key;Version=1.0;"
  },
  "BigCommerce": {
    "BaseUrl": "https://api.bigcommerce.com",
    "RequestTimeout": "00:00:30",
    "MaxRetries": 3,
    "RateLimitRequestsPerSecond": 12,
    "EnableDebugLogging": false,
    "UserAgent": "BigCommerce-Migration-System/1.0"
  },
  "OpenSearch": {
    "Endpoint": "#{OpenSearch.Endpoint}#",
    "Username": "#{OpenSearch.Username}#",
    "Password": "#{OpenSearch.Password}#", 
    "DefaultIndex": "bigcommerce-migration-logs",
    "RequestTimeout": "00:00:30",
    "MaxRetries": 3,
    "EnableDebugMode": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Debug",
      "BigCommerce.Migration": "Debug"
    }
  }
} 