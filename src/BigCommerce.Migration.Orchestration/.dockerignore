# Orchestration Library Project - .dockerignore
# Exclude build artifacts
obj/
bin/
TestResults/
*.user
*.suo
*.tmp
*.log

# Exclude development tools
.vs/
.vscode/
.idea/

# Exclude OS files
.DS_Store
Thumbs.db

# Exclude Git
.git/
.gitignore

# Exclude NuGet packages
packages/
.nuget/

# Exclude documentation
*.md
README*

# Exclude work-in-progress files
*.wip

# This is a library project - keep only source code
!Activities/
!Services/
!Orchestrators/
!Strategies/
!Models/
!Extensions/
!Pipeline/
!**/*.cs
!**/*.csproj 