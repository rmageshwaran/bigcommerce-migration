# Test Projects - .dockerignore
# Exclude build artifacts
**/obj/
**/bin/
**/TestResults/
*.user
*.suo
*.tmp
*.log

# Exclude development tools
.vs/
.vscode/
.idea/

# Exclude OS files
.DS_Store
Thumbs.db

# Exclude Git
.git/
.gitignore

# Exclude NuGet packages (will be restored)
packages/
.nuget/

# Exclude documentation
*.md
README*

# Exclude non-test projects for test-only containers
../src/BigCommerce.Migration.Dashboard/
../docs/
../iac/
../scripts/
../etl-benchmarks/

# Keep test projects and their dependencies
!BigCommerce.Migration.UnitTests/
!BigCommerce.Migration.IntegrationTests/
!BigCommerce.Migration.PerformanceTests/
!BigCommerce.Migration.OrchestrationTests/
!**/*.cs
!**/*.csproj
!**/appsettings*.json 