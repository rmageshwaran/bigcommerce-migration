{
  "BigCommerce": {
    "BaseUrl": "https://api.bigcommerce.com",
    "RequestTimeout": "00:01:00",
    "MaxRetries": 5,
    "RateLimitRequestsPerSecond": 12,
    "EnableDebugLogging": true,
    "UserAgent": "BigCommerce-Migration-Integration-Tests/1.0",
    "SourceStore": {
      "StoreId": "v6q95r5n91",
      "AccessToken": "#{BigCommerce.SourceStore.AccessToken}#",
      "ChannelId": "1"
    },
    "DestinationStore": {
      "StoreId": "in2msaitrc",
      "AccessToken": "#{BigCommerce.DestinationStore.AccessToken}#",
      "ChannelId": "1"
    }
  },
  "Integration": {
    "TestTimeoutMinutes": 15,
    "MaxTestEntities": 100,
    "EnableCleanupAfterTests": true,
    "TestDataPrefix": "IntegrationTest_",
    "EnablePerformanceMetrics": true,
    "EnableRealTimeMonitoring": true
  },
  "OpenSearch": {
    "Endpoint": "#{OpenSearch.Endpoint}#",
    "Username": "#{OpenSearch.Username}#",
    "Password": "#{OpenSearch.Password}#",
    "DefaultIndex": "bigcommerce-migration-integration-tests",
    "RequestTimeout": "00:00:30",
    "MaxRetries": 3,
    "EnableDebugMode": true
  },
  "Storage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "TablePrefix": "IntegrationTest",
    "BlobContainerPrefix": "integrationtest"
  },
  "SignalR": {
    "BaseUrl": "http://localhost:7071",
    "TimeoutSeconds": 5,
    "Enabled": false,
    "EnableDebugLogging": true,
    "MaxRetries": 0,
    "EnableAsyncQueuing": false,
    "EnableBatching": false,
    "EnableHttpService": false,
    "Batching": {
      "BatchSize": 3,
      "BatchTimeoutMs": 100,
      "MaxQueueSize": 100,
      "Enabled": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "BigCommerce.Migration": "Debug",
      "BigCommerce.Migration.IntegrationTests": "Debug"
    },
    "Console": {
      "IncludeScopes": true,
      "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff "
    }
  }
} 