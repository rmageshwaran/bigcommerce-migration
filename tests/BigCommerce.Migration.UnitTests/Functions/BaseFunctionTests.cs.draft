using Microsoft.Azure.Functions.Worker.Http;
using Microsoft.Extensions.Logging;
using Moq;
using System.Net;
using System.Text.Json;
using Xunit;
using System.Text;
using BigCommerce.Migration.Functions.Base;

namespace BigCommerce.Migration.UnitTests.Functions;

/// <summary>
/// Tests for BaseFunction class - common functionality for all Azure Function classes
/// Tests define expected behavior for Task 2.1.2 (TDD approach)
/// </summary>
public class BaseFunctionTests
{
    private readonly Mock<ILogger> _loggerMock;
    private readonly TestableBaseFunction _baseFunction;

    public BaseFunctionTests()
    {
        _loggerMock = new Mock<ILogger>();
        _baseFunction = new TestableBaseFunction(_loggerMock.Object);
    }

    [Fact]
    public void Constructor_WithNullLogger_ShouldThrowArgumentNullException()
    {
        // Act & Assert
        Assert.Throws<ArgumentNullException>(() => new TestableBaseFunction(null!));
    }

    [Fact]
    public void DefaultJsonOptions_ShouldUseCamelCaseNamingPolicy()
    {
        // Act
        var options = _baseFunction.GetDefaultJsonOptions();

        // Assert
        Assert.NotNull(options);
        Assert.Equal(JsonNamingPolicy.CamelCase, options.PropertyNamingPolicy);
        Assert.True(options.PropertyNameCaseInsensitive);
    }

    [Fact]
    public async Task CreateErrorResponseAsync_WithValidParameters_ShouldReturnErrorResponse()
    {
        // Arrange
        var mockRequest = new Mock<HttpRequestData>();
        var mockResponse = new Mock<HttpResponseData>();
        var statusCode = HttpStatusCode.BadRequest;
        var message = "Test error message";
        var contextId = "test-context-123";

        mockRequest.Setup(r => r.CreateResponse(statusCode)).Returns(mockResponse.Object);
        mockResponse.Setup(r => r.Headers).Returns(new HttpHeadersCollection());
        
        var writeAsyncCalled = false;
        mockResponse.Setup(r => r.WriteStringAsync(It.IsAny<string>()))
                   .Callback(() => writeAsyncCalled = true)
                   .Returns(Task.CompletedTask);

        // Act
        var result = await _baseFunction.CreateErrorResponseAsync(mockRequest.Object, statusCode, message, contextId);

        // Assert
        Assert.NotNull(result);
        Assert.Equal(mockResponse.Object, result);
        Assert.True(writeAsyncCalled);
    }

    [Fact]
    public async Task CreateSuccessResponseAsync_WithData_ShouldReturnSuccessResponse()
    {
        // Arrange
        var mockRequest = new Mock<HttpRequestData>();
        var mockResponse = new Mock<HttpResponseData>();
        var testData = new { message = "Success", id = 123 };

        mockRequest.Setup(r => r.CreateResponse(HttpStatusCode.OK)).Returns(mockResponse.Object);
        mockResponse.Setup(r => r.Headers).Returns(new HttpHeadersCollection());
        
        var writeAsyncCalled = false;
        mockResponse.Setup(r => r.WriteStringAsync(It.IsAny<string>()))
                   .Callback(() => writeAsyncCalled = true)
                   .Returns(Task.CompletedTask);

        // Act
        var result = await _baseFunction.CreateSuccessResponseAsync(mockRequest.Object, testData);

        // Assert
        Assert.NotNull(result);
        Assert.Equal(mockResponse.Object, result);
        Assert.True(writeAsyncCalled);
    }

    [Fact]
    public async Task CreateSuccessResponseAsync_WithCustomStatusCode_ShouldReturnResponseWithCorrectStatusCode()
    {
        // Arrange
        var mockRequest = new Mock<HttpRequestData>();
        var mockResponse = new Mock<HttpResponseData>();
        var testData = new { message = "Created" };
        var statusCode = HttpStatusCode.Created;

        mockRequest.Setup(r => r.CreateResponse(statusCode)).Returns(mockResponse.Object);
        mockResponse.Setup(r => r.Headers).Returns(new HttpHeadersCollection());
        mockResponse.Setup(r => r.WriteStringAsync(It.IsAny<string>())).Returns(Task.CompletedTask);

        // Act
        var result = await _baseFunction.CreateSuccessResponseAsync(mockRequest.Object, testData, statusCode);

        // Assert
        Assert.NotNull(result);
        mockRequest.Verify(r => r.CreateResponse(statusCode), Times.Once);
    }

    [Fact]
    public async Task ReadRequestBodyAsync_WithValidRequest_ShouldReturnRequestBody()
    {
        // Arrange
        var requestBody = "test request body";
        var stream = new MemoryStream(Encoding.UTF8.GetBytes(requestBody));
        var mockRequest = new Mock<HttpRequestData>();
        
        mockRequest.Setup(r => r.Body).Returns(stream);

        // Act
        var result = await _baseFunction.ReadRequestBodyAsync(mockRequest.Object);

        // Assert
        Assert.Equal(requestBody, result);
    }

    [Fact]
    public async Task DeserializeRequestAsync_WithValidJson_ShouldReturnDeserializedObject()
    {
        // Arrange
        var testObject = new TestRequestModel { Name = "Test", Value = 42 };
        var json = JsonSerializer.Serialize(testObject, _baseFunction.GetDefaultJsonOptions());
        var stream = new MemoryStream(Encoding.UTF8.GetBytes(json));
        var mockRequest = new Mock<HttpRequestData>();
        
        mockRequest.Setup(r => r.Body).Returns(stream);

        // Act
        var result = await _baseFunction.DeserializeRequestAsync<TestRequestModel>(mockRequest.Object);

        // Assert
        Assert.NotNull(result);
        Assert.Equal(testObject.Name, result.Name);
        Assert.Equal(testObject.Value, result.Value);
    }

    [Fact]
    public async Task DeserializeRequestAsync_WithInvalidJson_ShouldThrowJsonException()
    {
        // Arrange
        var invalidJson = "{ invalid json }";
        var stream = new MemoryStream(Encoding.UTF8.GetBytes(invalidJson));
        var mockRequest = new Mock<HttpRequestData>();
        
        mockRequest.Setup(r => r.Body).Returns(stream);

        // Act & Assert
        await Assert.ThrowsAsync<JsonException>(() => 
            _baseFunction.DeserializeRequestAsync<TestRequestModel>(mockRequest.Object));
    }

    [Fact]
    public async Task DeserializeRequestAsync_WithEmptyBody_ShouldThrowArgumentException()
    {
        // Arrange
        var stream = new MemoryStream();
        var mockRequest = new Mock<HttpRequestData>();
        
        mockRequest.Setup(r => r.Body).Returns(stream);

        // Act & Assert
        await Assert.ThrowsAsync<ArgumentException>(() => 
            _baseFunction.DeserializeRequestAsync<TestRequestModel>(mockRequest.Object));
    }

    [Fact]
    public void SerializeObject_WithValidObject_ShouldReturnJsonString()
    {
        // Arrange
        var testObject = new { name = "Test", value = 42 };

        // Act
        var result = _baseFunction.SerializeObject(testObject);

        // Assert
        Assert.NotNull(result);
        Assert.Contains("\"name\":\"Test\"", result);
        Assert.Contains("\"value\":42", result);
    }

    [Fact]
    public void GenerateContextId_ShouldReturnValidGuid()
    {
        // Act
        var result = _baseFunction.GenerateContextId();

        // Assert
        Assert.NotNull(result);
        Assert.True(Guid.TryParse(result, out _));
    }

    /// <summary>
    /// Testable implementation of BaseFunction for testing purposes
    /// </summary>
    private class TestableBaseFunction : BaseFunction
    {
        public TestableBaseFunction(ILogger logger) : base(logger) { }

        // Expose protected methods for testing - avoid optional parameters in method signatures
        public new JsonSerializerOptions GetDefaultJsonOptions() => base.GetDefaultJsonOptions();
        public new Task<HttpResponseData> CreateErrorResponseAsync(HttpRequestData request, HttpStatusCode statusCode, string message, string contextId) 
            => base.CreateErrorResponseAsync(request, statusCode, message, contextId);
        public new Task<HttpResponseData> CreateSuccessResponseAsync<T>(HttpRequestData request, T data, HttpStatusCode statusCode) 
            => base.CreateSuccessResponseAsync(request, data, statusCode);
        public Task<HttpResponseData> CreateSuccessResponseAsync<T>(HttpRequestData request, T data) 
            => base.CreateSuccessResponseAsync(request, data, HttpStatusCode.OK);
        public new Task<string> ReadRequestBodyAsync(HttpRequestData request) 
            => base.ReadRequestBodyAsync(request);
        public new Task<T> DeserializeRequestAsync<T>(HttpRequestData request) 
            => base.DeserializeRequestAsync<T>(request);
        public new string SerializeObject<T>(T obj) 
            => base.SerializeObject(obj);
        public new string GenerateContextId() 
            => base.GenerateContextId();
    }

    /// <summary>
    /// Test model for deserialization tests
    /// </summary>
    private class TestRequestModel
    {
        public string Name { get; set; } = string.Empty;
        public int Value { get; set; }
    }
} 